   "protocol": "config",
   "ports": {
    "valid": "cfg_valid",
    "ready": "cfg_ready",
    "addr": "cfg_addr",
    "data": "cfg_data"
   }
  },
  {
   "name": "row",
   "protocol": "row_pipe",
   "ports": {
    "re": "p_re",
    "row": "p_row",
    "data_in": "acc_row",
    "en": "en",
    "data_out": "y_row"
   }
  }
 ],
 "capabilities": [
  {
   "op": "requant",
   "in": "int(AW)",
   "out": "int8",
   "scale": "per_channel",
   "reference": "generator/isa.py post_op"
  }
 ],
 "files": {
