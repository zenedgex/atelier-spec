 "parameters": {
  "C": {
   "rule": "row width in channels"
  },
  "AW": {
   "rule": "accumulator width"
  },
  "PCH": {
   "rule": "channels with parameters"
  },
  "PRB": {
   "rule": "clog2(PCH/C) (derived)"
  },
  "STAGES": {
   "values": [
    6
   ],
   "meaning": "fixed pipeline depth"
  }
 },
 "port_groups": [
  {
