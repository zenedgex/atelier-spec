   "op": "im2col_load",
   "reference": "generator/isa.py"
  },
  {
   "op": "elt_add",
   "reference": "generator/isa.py"
  },
  {
   "op": "elt_mul",
   "reference": "generator/isa.py"
  },
  {
   "op": "elt_max",
   "reference": "generator/isa.py"
  },
  {
   "op": "pool_max",
   "reference": "generator/isa.py"
  },
  {
   "op": "map_lut",
   "reference": "generator/isa.py"
  }
 ],
 "files": {
