{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atelier-machine/0.2",
  "title": "Atelier machine description",
  "type": "object",
  "required": [
    "standard",
    "name",
    "units",
    "memory",
    "control"
  ],
  "properties": {
    "standard": {
      "type": "string",
      "pattern": "^atelier-machine/0\\.[12]$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "units": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string"
          },
          "block": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "capabilities": {
            "type": "object"
          },
          "control": {
            "enum": [
              "command",
              "isa",
              "none"
            ]
          },
          "core": {
            "type": "object"
          }
        },
        "anyOf": [
          {
            "required": [
              "class"
            ]
          },
          {
            "required": [
              "block"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "clusters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "count",
          "contains"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "contains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "wiring": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "memory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "level",
          "kind",
          "per"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "register_file",
              "scratchpad",
              "cache",
              "tcm",
              "compute",
              "dram",
              "rom"
            ]
          },
          "per": {
            "type": "string"
          },
          "size": {
            "type": [
              "string",
              "integer"
            ]
          },
          "banks": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "ports": {
            "type": "integer",
            "minimum": 1
          },
          "ways": {
            "type": "integer",
            "minimum": 1
          },
          "line": {
            "type": [
              "string",
              "integer"
            ]
          },
          "latency": {
            "type": [
              "integer",
              "string"
            ]
          },
          "energy": {},
          "policy": {
            "enum": [
              "scratchpad",
              "cache"
            ]
          },
          "type": {
            "type": "string"
          },
          "bandwidth": {
            "type": [
              "string",
              "number"
            ]
          },
          "block": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "share": {
            "enum": [
              "arbiter",
              "dual_port",
              "bank_split"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "movement": {
      "type": "object",
      "properties": {
        "dma": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "engine",
              "from",
              "to"
            ],
            "properties": {
              "engine": {
                "type": "string"
              },
              "from": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                ]
              },
              "to": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "bridges": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "unit",
              "direction"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "direction": {
                "enum": [
                  "in",
                  "out"
                ]
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "interconnect": {
      "type": "object",
      "properties": {
        "topology": {
          "enum": [
            "bus",
            "crossbar",
            "noc",
            "auto"
          ]
        },
        "protocol": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "masters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slaves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "model",
        "core"
      ],
      "properties": {
        "model": {
          "enum": [
            "microcontroller",
            "application",
            "host",
            "computing"
          ]
        },
        "core": {
          "type": "string"
        },
        "os": {
          "enum": [
            "none",
            "rtos",
            "linux"
          ]
        }
      }
    },
    "address_map": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "base",
          "size"
        ],
        "properties": {
          "base": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": [
              "string",
              "integer"
            ]
          },
          "stride": {
            "type": [
              "string",
              "integer"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "clocks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "freq",
          "units"
        ],
        "properties": {
          "freq": {
            "type": [
              "string",
              "number"
            ]
          },
          "units": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1
      }
    },
    "dispatch": {
      "type": "object",
      "required": [
        "by"
      ],
      "properties": {
        "by": {
          "type": "string"
        },
        "per": {
          "type": "string"
        },
        "tokens": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        },
        "queues": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "depth": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
