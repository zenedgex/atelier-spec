{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "atelier-profile/0.1",
 "title": "Atelier profile: measured per-layer results of one run",
 "type": "object",
 "required": [
  "standard",
  "run",
  "layers"
 ],
 "additionalProperties": false,
 "properties": {
  "standard": {
   "const": "atelier-profile/0.1"
  },
  "run": {
   "type": "object",
   "required": [
    "machine",
    "evidence"
   ],
   "additionalProperties": false,
   "properties": {
    "machine": {
     "type": "object",
     "required": [
      "name"
     ],
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "hash": {
       "type": "string"
      },
      "params": {
       "type": "object"
      }
     }
    },
    "network": {
     "type": "string"
    },
    "batch": {
     "type": "integer",
     "minimum": 1
    },
    "compiler": {
     "type": "object",
     "required": [
      "name"
     ],
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      },
      "options": {}
     }
    },
    "clock": {
     "type": [
      "string",
      "number"
     ]
    },
    "evidence": {
     "type": "string"
    },
    "tool": {
     "type": "string"
    },
    "date": {
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "total": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "cycles": {
     "type": "integer",
     "minimum": 0
    },
    "note": {
     "type": "string"
    }
   }
  },
  "layers": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "op",
     "cycles"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "op": {
      "type": "string"
     },
     "shapes": {
      "type": "object"
     },
     "formats": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^(u?int[1-9][0-9]*|fp8_e4m3|fp8_e5m2|fp16|bf16|fp32|fp64)$"
      }
     },
     "units": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "cycles": {
      "type": "integer",
      "minimum": 0
     },
     "start": {
      "type": "integer",
      "minimum": 0
     },
     "end": {
      "type": "integer",
      "minimum": 0
     },
     "macs": {
      "type": "integer",
      "minimum": 0
     },
     "activity": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "properties": {
        "busy": {
         "type": "integer",
         "minimum": 0
        },
        "stall": {
         "type": "integer",
         "minimum": 0
        },
        "start": {
         "type": "integer",
         "minimum": 0
        },
        "end": {
         "type": "integer",
         "minimum": 0
        }
       },
       "additionalProperties": false
      }
     },
     "bytes": {
      "type": "object",
      "additionalProperties": {
       "type": "integer",
       "minimum": 0
      }
     },
     "counters": {
      "type": "object"
     },
     "note": {
      "type": "string"
     }
    }
   }
  }
 }
}
